# Copy this file to .env and fill in the values. Never commit .env.
# Variable names come from the code: app/db/supabase_client.py,
# app/features/briefs/router.py, app/features/briefs/service.py,
# app/features/contact/service.py and app/main.py.

# Supabase project REST URL, e.g. https://<project-ref>.supabase.co
# Required. The app raises at import time and will not start without it.
SUPABASE_URL=

# Supabase API key. Use the ANON key, not the service role key: this repo and
# its GitHub Actions logs are public. Required, same startup check as above.
SUPABASE_KEY=

# Resend API key, used for the contact notification and the brief email.
# Optional. When empty, both endpoints log a warning and skip the email
# instead of failing the request.
RESEND_API_KEY=

# Root log level: DEBUG, INFO, WARNING, ERROR. Optional, defaults to INFO.
LOG_LEVEL=INFO
